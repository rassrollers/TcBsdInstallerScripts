#!/bin/sh

set -e
set -u

# Replace with the actual IPC firmware version if available
IPC_VERSION="1.0.0"

# Create custom login message
# You can create your own text logo here: https://patorjk.com/software/taag/
echo "[170-login-template] INFO: Setting up motd.template for login message"
cat <<EOF > /etc/motd.template
M   M Y   Y       TTTTT  CCC      / BBBB   SSSS DDDD        PPPP  L      CCC  
MM MM  Y Y          T   C   C    /  B   B S     D   D       P   P L     C   C 
M M M   Y           T   C       /   BBBB   SSS  D   D       PPPP  L     C     
M   M   Y           T   C   C  /    B   B     S D   D       P     L     C   C 
M   M   Y           T    CCC  /     BBBB  SSSS  DDDD        P     LLLLL  CCC                                                                      

IPC firmware version ${IPC_VERSION}
EOF
